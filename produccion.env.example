# Plantilla de variables de entorno de producción.
# Copiar a produccion.env (gitignored) y llenar con los valores reales del secret manager.

# Ya existentes
CONNECTION_STRS_CONS_PROD=
REDIS_CONFIG=
SERVICESTACK_LICENSE=
DEVART_KEYS=
ASPNETCORE_ENVIRONMENT=Production

# Secretos retirados de appsettings.json (auditoría 2026-06-10, F1)
# La configuración de .NET los toma del entorno; los anidados usan __ como separador.
jwt.AuthKeyBase64=
secret=
# Alias sin punto (red de seguridad si el runtime no acepta el punto en el nombre).
# Program.cs usa estos si las claves con punto llegan vacías. Mismo valor que arriba.
JWT_AUTHKEY_BASE64=
JWT_SECRET=
GoogleReCaptcha__SecretKey=
Email__SmtpUsuario=
Email__SmtpClave=
VapidPrivate=
WPSid=
WPToken=

# Llave de cifrado de links públicos y credenciales SMTP (antes hardcodeada "aF8S-Z").
# Rotarla invalida links en vuelo y exige re-cifrar Email__SmtpUsuario/SmtpClave.
TYC_LLAVE_PARAMETRO_LINK=
